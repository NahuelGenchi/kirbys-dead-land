<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ModName>KirbySuperStarUltra</ModName>
    <ModType>mod</ModType>
    <ModMain>Kirby.Runtime.KirbyMod</ModMain>
    <Version>0.2.1</Version>
    <AutoInstallMod>false</AutoInstallMod>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DeadCellsCoreModding.MDK" Version="1.0.1" />
    <ProjectReference Include="../core/Kirby.Core.csproj" />
    <ModAssembly Include="Kirby.Core" />
    <OutputFiles Include="$(MSBuildProjectDirectory)/config.json" />
  </ItemGroup>

  <!-- The packed Kirby.Core and Kirby.Runtime carry ahead-of-time (ReadyToRun) code, so the
       first frame Kirby plays does not wait for the JIT (#184). The IL build in bin/ is
       unchanged. -p:ModReadyToRun=false packs the IL alone. The code is for the build
       machine's system; -p:ModReadyToRunOS=windows compiles it for Windows on Linux (#244). -->
  <PropertyGroup>
    <ModReadyToRun Condition="'$(ModReadyToRun)' == ''">true</ModReadyToRun>
    <ModBuildOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</ModBuildOS>
    <ModBuildOS Condition="'$(ModBuildOS)' == ''">linux</ModBuildOS>
    <ModReadyToRunOS Condition="'$(ModReadyToRunOS)' == ''">$(ModBuildOS)</ModReadyToRunOS>
  </PropertyGroup>
  <ItemGroup Condition="'$(ModReadyToRun)' == 'true'">
    <PackageDownload Include="Microsoft.NETCore.App.Crossgen2.$(NETCoreSdkRuntimeIdentifier)" Version="[$(BundledNETCoreAppPackageVersion)]" />
    <!-- Compiled for another system, the code references that system's own framework, as the SDK's ReadyToRun does. -->
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.win-x64" Version="[$(BundledNETCoreAppPackageVersion)]"
                     Condition="'$(ModReadyToRunOS)' == 'windows' and '$(ModBuildOS)' != 'windows'" />
  </ItemGroup>
  <Target Name="ModReadyToRunInputs">
    <PropertyGroup>
      <ModReadyToRunPath>$(IntermediateOutputPath)r2r/$(ModReadyToRunOS)/</ModReadyToRunPath>
      <ModReadyToRunFramework Condition="'$(ModReadyToRunOS)' == 'windows' and '$(ModBuildOS)' != 'windows'">$(NuGetPackageRoot)microsoft.netcore.app.runtime.win-x64/$(BundledNETCoreAppPackageVersion)/runtimes/win-x64/</ModReadyToRunFramework>
      <ModCrossgen>$(NuGetPackageRoot)microsoft.netcore.app.crossgen2.$(NETCoreSdkRuntimeIdentifier)/$(BundledNETCoreAppPackageVersion)/tools/crossgen2</ModCrossgen>
      <ModCrossgen Condition="'$(ModBuildOS)' == 'windows'">$(ModCrossgen).exe</ModCrossgen>
    </PropertyGroup>
    <ItemGroup>
      <!-- The game runs on the SDK's own runtime, so its framework is the reference. -->
      <ModReadyToRunReference Include="$(NetCoreRoot)shared/Microsoft.NETCore.App/$(BundledNETCoreAppPackageVersion)/*.dll" Condition="'$(ModReadyToRunFramework)' == ''" />
      <ModReadyToRunReference Include="$(ModReadyToRunFramework)lib/net10.0/*.dll" Condition="'$(ModReadyToRunFramework)' != ''" />
      <ModReadyToRunReference Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == '' and '%(ReferencePath.ReferenceSourceTarget)' != 'ProjectReference'" />
      <ModReadyToRunReference Include="@(_MDK_ModAssembly_Dll)" />
    </ItemGroup>
  </Target>
  <Target Name="CompileModReadyToRun" DependsOnTargets="ModReadyToRunInputs"
          Inputs="@(_MDK_ModAssembly_Dll);@(ModReadyToRunReference);$(MSBuildProjectFullPath)"
          Outputs="@(_MDK_ModAssembly_Dll->'$(ModReadyToRunPath)%(Filename)%(Extension)')">
    <Error Condition="!Exists('$(ModCrossgen)')" Text="crossgen2 was not restored: $(ModCrossgen)" />
    <Error Condition="'$(ModReadyToRunOS)' != 'linux' and '$(ModReadyToRunOS)' != 'windows'" Text="ModReadyToRunOS is linux or windows, not $(ModReadyToRunOS)." />
    <Error Condition="'$(ModReadyToRunOS)' != '$(ModBuildOS)' and '$(ModReadyToRunOS)' != 'windows'" Text="Linux code is compiled on Linux." />
    <!-- One image per assembly: each is its own version bubble, as the SDK compiles them. -->
    <WriteLinesToFile File="$(ModReadyToRunPath)%(_MDK_ModAssembly_Dll.Filename).rsp" Overwrite="true"
                      Lines="%(_MDK_ModAssembly_Dll.FullPath);-o:$(ModReadyToRunPath)%(_MDK_ModAssembly_Dll.Filename)%(_MDK_ModAssembly_Dll.Extension);--targetos:$(ModReadyToRunOS);--targetarch:x64;-O;@(ModReadyToRunReference->'-r:%(FullPath)')" />
    <Exec Command="&quot;$(ModCrossgen)&quot; @&quot;$(ModReadyToRunPath)%(_MDK_ModAssembly_Dll.Filename).rsp&quot;" />
  </Target>
  <Target Name="PackModReadyToRun" BeforeTargets="CopyOutputFiles" DependsOnTargets="CompileModReadyToRun"
          Condition="'$(ModReadyToRun)' == 'true'">
    <ItemGroup>
      <OutputFiles Remove="@(_MDK_ModAssembly_Dll)" />
      <OutputFiles Include="@(_MDK_ModAssembly_Dll->'$(ModReadyToRunPath)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
</Project>
