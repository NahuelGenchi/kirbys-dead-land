<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GameRes.Core">
      <HintPath>$(DCCM_MDK_ROOT)/../host/GameRes.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckReleasedReader" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(DCCM_MDK_ROOT)/../host/GameRes.Core.dll')"
           Text="Set DCCM_MDK_ROOT to the released Linux DCCM core/mdk directory (scripts/setup_runtime.py)." />
  </Target>
</Project>
