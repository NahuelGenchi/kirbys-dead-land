// Settings, licenses, questions and the short notices that float above the screens.
import { Theme, Art, Tone } from "theme.slint";
import { Drawn, Icons, Icon, PrimaryButton, SecondaryButton, LinkButton, IconButton, Card, FocusLayer } from "widgets.slint";

component Switch {
    in-out property <bool> checked;
    in property <string> label;
    in property <int> layer: 0;
    callback toggled(bool);
    width: 44px;
    height: 26px;
    forward-focus: focus;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(root.checked); }
    Rectangle {
        border-radius: root.height / 2;
        background: root.checked ? Theme.pink : #ffffff24;
        animate background { duration: 160ms; }
    }
    Rectangle {
        x: root.checked ? root.width - self.width - 3px : 3px;
        width: root.height - 6px;
        height: root.height - 6px;
        border-radius: self.height / 2;
        background: white;
        animate x { duration: 160ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
    focus := FocusScope {
        focus-on-tab-navigation: root.layer == FocusLayer.top;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.checked = !root.checked; root.toggled(root.checked); return accept; }
            reject
        }
    }
}

component SectionTitle inherits Text {
    font-family: Theme.display;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 1.8px;
    color: Theme.ink-faint;
}

component SettingRow {
    in property <image> icon;
    in property <string> title;
    in property <string> detail;
    in property <string> action;
    in property <bool> action-enabled: true;
    in property <bool> action-busy;
    callback clicked;
    min-height: 60px;
    HorizontalLayout {
        spacing: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 12px;
                background: #ffffff0f;
                Icon { source: root.icon; color: Theme.pink-soft; width: 19px; height: 19px; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; font-family: Theme.display; font-weight: 600; font-size: 15px; color: Theme.ink; overflow: elide; }
            if root.detail != "": Text { text: root.detail; font-size: 13px; color: Theme.ink-faint; wrap: word-wrap; }
        }
        if root.action != "": VerticalLayout {
            alignment: center;
            SecondaryButton {
                text: root.action;
                height: 34px;
                layer: 1;
                font-size: 13.5px;
                enabled: root.action-enabled;
                busy: root.action-busy;
                clicked => { root.clicked(); }
            }
        }
        @children
    }
}

export component SettingsSheet {
    in property <bool> open;
    in property <string> version;
    in property <string> rom-name;
    in property <string> rom-detail;
    in property <string> game-detail;
    in property <string> game-path;
    in property <string> data-detail;
    in property <string> update-detail;
    in property <string> update-action;
    in property <bool> update-busy;
    in property <bool> setup-running;
    in property <bool> setup-done;
    in-out property <bool> auto-update;
    callback close();
    callback act(/* change-rom, open-saves, open-backups, open-log, repair, open-data, update, licenses, source */ string);
    callback auto-update-changed(bool);

    property <length> sheet-width: 452px;

    if root.open: TouchArea {
        clicked => { root.close(); }
    }
    Rectangle {
        background: #03041499;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: 220ms; }
    }
    sheet := Rectangle {
        x: root.open ? root.width - root.sheet-width : root.width + 40px;
        y: 0;
        width: root.sheet-width;
        height: root.height;
        animate x { duration: 260ms; easing: ease-out; }
        Drawn {
            x: -40px;
            y: -40px;
            width: parent.width + 80px;
            height: parent.height + 80px;
            source: Art.glow(parent.width, parent.height, 0px, 40px, #000000b0);
        }
        Rectangle { background: Theme.surface-solid; }
        Rectangle { x: 0; width: 1px; background: Theme.line-strong; }
        TouchArea { }
        HorizontalLayout {
            y: 0;
            height: 76px;
            padding-left: 30px;
            padding-right: 18px;
            Text {
                text: "Settings";
                font-family: Theme.display;
                font-weight: 600;
                font-size: 25px;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                IconButton { icon: Icons.x; label: "Close settings"; layer: 1; autofocus: true; clicked => { root.close(); } }
            }
        }
        list := Flickable {
            y: 76px;
            height: parent.height - 76px;
            content-height: content.preferred-height;
            content := VerticalLayout {
                padding-left: 30px;
                padding-right: 30px;
                padding-bottom: 30px;
                spacing: 4px;
                SectionTitle { text: "YOUR GAMES"; }
                SettingRow {
                    icon: Icons.file-search;
                    title: root.rom-name;
                    detail: root.rom-detail;
                    action: "Change";
                    action-enabled: !root.setup-running;
                    clicked => { root.act("change-rom"); }
                }
                SettingRow {
                    icon: Icons.gamepad;
                    title: "Dead Cells";
                    detail: root.game-detail + "\n" + root.game-path;
                }
                Rectangle { height: 14px; }
                SectionTitle { text: "SAVES AND LOGS"; }
                SettingRow {
                    icon: Icons.save;
                    title: "Kirby's saves";
                    detail: "Kept apart from your Dead Cells saves";
                    action: "Open";
                    action-enabled: root.setup-done;
                    clicked => { root.act("open-saves"); }
                }
                SettingRow {
                    icon: Icons.shield;
                    title: "Save backups";
                    detail: "Your Dead Cells saves, copied before each game";
                    action: "Open";
                    clicked => { root.act("open-backups"); }
                }
                SettingRow {
                    icon: Icons.log;
                    title: "Last game log";
                    detail: "Useful when reporting a problem";
                    action: "Open";
                    clicked => { root.act("open-log"); }
                }
                Rectangle { height: 14px; }
                SectionTitle { text: "SETUP"; }
                SettingRow {
                    icon: Icons.wrench;
                    title: "Repair setup";
                    detail: "Builds everything again from your files";
                    action: "Repair";
                    action-enabled: !root.setup-running;
                    clicked => { root.act("repair"); }
                }
                SettingRow {
                    icon: Icons.drive;
                    title: "Launcher files";
                    detail: root.data-detail;
                    action: "Open";
                    clicked => { root.act("open-data"); }
                }
                Rectangle { height: 14px; }
                SectionTitle { text: "UPDATES"; }
                SettingRow {
                    icon: Icons.update;
                    title: "Version " + root.version;
                    detail: root.update-detail;
                    action: root.update-action;
                    action-busy: root.update-busy;
                    clicked => { root.act("update"); }
                }
                HorizontalLayout {
                    padding-left: 52px;
                    padding-top: 2px;
                    padding-bottom: 6px;
                    spacing: 12px;
                    Text {
                        text: "Look for a new version when the launcher opens";
                        font-size: 13px;
                        color: Theme.ink-dim;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            layer: 1;
                            label: "Look for a new version when the launcher opens";
                            checked <=> root.auto-update;
                            toggled(value) => { root.auto-update-changed(value); }
                        }
                    }
                }
                Rectangle { height: 18px; }
                Rectangle { height: 1px; background: Theme.line; }
                Rectangle { height: 14px; }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    LinkButton { text: "Licenses"; layer: 1; font-size: 13.5px; clicked => { root.act("licenses"); } }
                    LinkButton { text: "Source code"; layer: 1; icon: Icons.external; has-icon: true; font-size: 13.5px; clicked => { root.act("source"); } }
                }
                Rectangle { height: 8px; }
                Text {
                    text: "Kirby's Dead Land is a free fan project under the GPL. It is not affiliated with Nintendo, HAL Laboratory, Motion Twin or Evil Empire. You need your own copies of both games.";
                    font-size: 12px;
                    color: Theme.ink-faint;
                    wrap: word-wrap;
                }
            }
        }
        if list.content-height > list.height: Rectangle {
            x: parent.width - 7px;
            y: list.y + 4px + (-list.content-y / list.content-height) * (list.height - 8px);
            width: 4px;
            height: (list.height / list.content-height) * (list.height - 8px);
            border-radius: 2px;
            background: #ffffff2a;
        }
    }
}

// A centered panel above a dimmed window.
export component Modal {
    in property <length> panel-width: 480px;
    in property <length> panel-height;
    callback dismiss();
    TouchArea { clicked => { root.dismiss(); } }
    Rectangle { background: #030414a8; }
    Card {
        width: root.panel-width;
        height: root.panel-height;
        background: Theme.surface-solid;
        radius: 24px;
        TouchArea { }
        @children
    }
}

export component Question {
    in property <string> title;
    in property <string> body;
    in property <string> confirm;
    in property <string> cancel;
    in property <bool> warning;
    callback answer(bool);
    Modal {
        width: 100%;
        height: 100%;
        panel-width: 480px;
        panel-height: layout.preferred-height;
        dismiss => { root.answer(false); }
        layout := VerticalLayout {
            padding: 30px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Icon { source: root.warning ? Icons.warn : Icons.info; color: root.warning ? Theme.amber : Theme.pink-soft; width: 24px; height: 24px; }
                }
                Text {
                    text: root.title;
                    font-family: Theme.display;
                    font-weight: 600;
                    font-size: 22px;
                    color: Theme.ink;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
            Text { text: root.body; font-size: 15px; color: Theme.ink-dim; wrap: word-wrap; }
            Rectangle { height: 6px; }
            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                if root.cancel != "": VerticalLayout {
                    alignment: center;
                    SecondaryButton { text: root.cancel; layer: 3; autofocus: true; clicked => { root.answer(false); } }
                }
                PrimaryButton { text: root.confirm; height: 44px; font-size: 15.5px; glow: false; layer: 3; autofocus: root.cancel == ""; clicked => { root.answer(true); } }
            }
        }
    }
}

export component Licenses {
    in property <string> text;
    callback close();
    // The panel's size; its children are placed inside it.
    property <length> panel-width: min(760px, root.width - 80px);
    property <length> panel-height: min(560px, root.height - 80px);
    Modal {
        width: 100%;
        height: 100%;
        panel-width: root.panel-width;
        panel-height: root.panel-height;
        dismiss => { root.close(); }
        HorizontalLayout {
            y: 0;
            height: 72px;
            padding-left: 30px;
            padding-right: 18px;
            Text {
                text: "Licenses";
                font-family: Theme.display;
                font-weight: 600;
                font-size: 23px;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                IconButton { icon: Icons.x; label: "Close"; layer: 2; autofocus: true; clicked => { root.close(); } }
            }
        }
        Rectangle {
            x: 18px;
            y: 72px;
            width: root.panel-width - 36px;
            height: root.panel-height - 90px;
            border-radius: 14px;
            background: Theme.well;
            clip: true;
            text-view := Flickable {
                x: 16px;
                y: 14px;
                width: parent.width - 32px;
                height: parent.height - 28px;
                content-height: notice.preferred-height;
                notice := Text {
                    width: parent.width;
                    text: root.text;
                    font-size: 13px;
                    color: Theme.ink-dim;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component Toast {
    in property <string> text;
    in property <bool> shown;
    height: 44px;
    width: layout.preferred-width;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 200ms; }
    Rectangle {
        border-radius: root.height / 2;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.line-strong;
    }
    layout := HorizontalLayout {
        padding-left: 16px;
        padding-right: 20px;
        spacing: 10px;
        VerticalLayout { alignment: center; Icon { source: Icons.check; color: Theme.mint; width: 18px; height: 18px; } }
        Text { text: root.text; color: Theme.ink; font-size: 14px; font-weight: 700; vertical-alignment: center; }
    }
}
